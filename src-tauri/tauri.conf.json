{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fukidashi",
  "version": "0.1.0",
  "identifier": "com.jannchie.fukidashi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fukidashi",
        "width": 460,
        "height": 700,
        "minWidth": 340,
        "minHeight": 320,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/lunahook/*"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Jannchie",
    "copyright": "© 2026 Jianqi Pan",
    "category": "Utility",
    "shortDescription": "把游戏里的日文实时抓出来，边玩边读",
    "license": "GPL-3.0-or-later",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNUVDRjJDRjNCMUY4NzMKUldSeitMSHpMTTllNGdsUG9XUmg3K0VJaUdkK2E4SkV1NkZvb3k4djJudEhWd002WWl0REJRdWsK",
      "endpoints": [
        "https://github.com/Jannchie/fukidashi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}